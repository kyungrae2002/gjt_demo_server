# === DB (Supabase PostgreSQL) ===
# Supabase 콘솔 → Project Settings → Database → Connection string → "Session pooler" 값 사용
# (Session pooler = IPv4 지원 + SQLAlchemy/psycopg2 호환. 직결(db.<ref>.supabase.co)은 IPv6 이슈 가능)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<db-password>

# === OCR (Vision LLM via OpenRouter) ===
# openrouter.ai → Keys 에서 발급. OCR_MODEL 은 반드시 "이미지 입력 지원" 모델이어야 함.
OPENROUTER_API_KEY=sk-or-...
OCR_MODEL=google/gemma-3-27b-it

# === 시연 모드 ===
# true이면 OCR은 test/demo_fixture.json의 고정된 실제 OCR 결과를 사용한다.
# 나머지 기존 API(점검·제품·최적화·출동·동선)는 실제 코드로 동작하며,
# PostgreSQL/Supabase 대신 로컬 SQLite에만 저장한다. 따라서 운영 DB는 변경되지 않는다.
# 최초 실행 시 고정 OCR 결과를 입력으로 실제 점검·최적화·동선 계산까지 실행해 SQLite에 저장한다.
# 이후 모든 GET/POST/PATCH는 이 실제 결과를 사용하며, 변경값은 재시작해도 유지된다.
DEMO_MODE=false
# (선택) 시연 SQLite 경로. 기본값은 test/demo.sqlite3
# DEMO_DB_PATH=test/demo.sqlite3

# === API 키 인증 ===
# 설정 시 모든 요청에 헤더 X-API-Key 로 이 값을 보내야 함(문서·헬스체크 제외).
# 미설정 시 인증 없음. 운영(Railway)에는 반드시 설정 권장. 길고 무작위한 값 사용.
API_KEY=<random-secret>

# === 로그인/계정 복구 ===
# 액세스 토큰 서명 키. 운영에서는 API_KEY와 별도로 긴 무작위 값을 사용한다.
AUTH_SECRET_KEY=<long-random-secret>
# ACCESS_TOKEN_MINUTES=60
# PASSWORD_RESET_MINUTES=15

# 비밀번호 재설정 링크를 보낼 SMTP 설정.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=no-reply@gmail.com
SMTP_USERNAME=no-reply@gmail.com
SMTP_PASSWORD=<smtp-password>
SMTP_USE_TLS=true
PASSWORD_RESET_URL=https://gwanzae.vercel.app/reset-password

# 로컬 개발에서만 true로 설정하면 /auth/forgot-password 응답에 reset_token이 포함된다.
# 운영에서는 절대 활성화하지 않는다.
PASSWORD_RESET_RETURN_TOKEN=false

# (선택) macOS에서 PuLP 번들 CBC가 안 돌 때 쓸 네이티브 CBC 경로.
# 미지정 시 macOS는 /opt/homebrew/bin/cbc, Linux는 PuLP 번들 CBC를 자동 사용.
# CBC_PATH=/opt/homebrew/bin/cbc