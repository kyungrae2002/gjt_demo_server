# === DB (Supabase PostgreSQL) ===
# Supabase 콘솔 → Project Settings → Database → Connection string → "Session pooler" 값 사용
# (Session pooler = IPv4 지원 + SQLAlchemy/psycopg2 호환. 직결(db.<ref>.supabase.co)은 IPv6 이슈 가능)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<db-password>

# === OCR (Vision LLM via OpenRouter) ===
# openrouter.ai → Keys 에서 발급. OCR_MODEL 은 반드시 "이미지 입력 지원" 모델이어야 함.
OPENROUTER_API_KEY=sk-or-...
OCR_MODEL=google/gemma-3-27b-it

# === API 키 인증 ===
# 설정 시 모든 요청에 헤더 X-API-Key 로 이 값을 보내야 함(문서·헬스체크 제외).
# 미설정 시 인증 없음. 운영(Railway)에는 반드시 설정 권장. 길고 무작위한 값 사용.
API_KEY=<random-secret>

# === (선택) S3 — /products/import 에서만 사용 ===
AWS_REGION=ap-northeast-2
S3_BUCKET=<bucket-name>

# (선택) macOS에서 PuLP 번들 CBC가 안 돌 때 쓸 네이티브 CBC 경로.
# 미지정 시 macOS는 /opt/homebrew/bin/cbc, Linux는 PuLP 번들 CBC를 자동 사용.
# CBC_PATH=/opt/homebrew/bin/cbc

